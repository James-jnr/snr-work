API_KEY=xCXubbxawpel6BPAj_jStHi76sMZh_qQf63jVgNMzkk
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_TO=you@gmail.com
DISPLAY_TZ=Africa/Nairobi
# Strategy knobs (course defaults shown)
MIN_GRADE=B
ASIA_HOURS=8
ZONE_PIPS=20
SIGNAL_COOLDOWN_H=8
ENABLE_MN1=true
# Optional: dates to flag as news days, e.g. 2026-12-05,2026-12-16
NO_TRADE_DATES=
# Optional: PIP_OVERRIDES={"XAUUSD":0.1}

# --- local run ---
# Start with:  uvicorn app.main:app --port 8000 --env-file .env
# UI_PUBLIC=true lets you open http://127.0.0.1:8000/ui without the key. LOCAL USE ONLY.
UI_PUBLIC=true
# Optional storage locations (defaults: snr.db and setups/ inside the backend folder)
# DB_PATH=
# SETUPS_DIR=

# Charts (one timeframe alone per image; attached to Telegram/email and saved with each alert)
CHARTS_IN_ALERTS=true
CHART_THEME=light        # light | dark
CHART_STYLE=line         # line = closes (as in the course) | candles

# v3 (all optional)
HEARTBEAT_SEC=15
MAX_TRADES_PER_DAY=3
MAX_CONSEC_LOSSES=3
SUPPRESS_WHEN_LIMIT=false
SHOW_INVALIDATION=true
ZONE_OVERLAP_PIPS=0        # 0 = automatic
MIN_TARGET_PIPS=8
# BASE_URL=http://192.168.1.20:8000   # only if the detected network address is wrong

# --- v4: 15-minute setup (Setup 4) ---
# ENABLE_M15=true
# CONFIRM_WINDOW_M15_H=2        # the 15-min break must come within this many hours of the 1-hour rejection
# M15_ENTRY_MIN=45              # entry stays valid this many minutes after the 15-min break
# M15_COOLDOWN_MIN=45           # min minutes between 15-min alerts in the same direction
# M15_ZONE_COOLDOWN_H=3         # no second 15-min alert at the same entry level for this many hours
# M15_MIN_CLASS=B               # alert only when the 15-min class is this or better (A best, C = alert everything)
# M15_ZONE_PIPS=0               # 1-hour rejection must sit this close to an H1/H4 key level (0 = 1.5 x zone overlap)
