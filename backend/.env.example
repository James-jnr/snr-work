TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_TO=you@gmail.com
DISPLAY_TZ=Africa/Nairobi
# Strategy configuration
# SL is entered manually in MT5; the backend calculates size only after SL is supplied.
TP_PIPS=100
RISK_PCT=1.0
RISK_PCT_REDUCED=0.5
MIN_GRADE=B
CONFIRM_WINDOW_H=4
ZONE_PIPS=20
DISPLAY_TZ=Africa/Nairobi
ENABLE_MN1=true
# Optional: dates to flag as news days, e.g. 2026-12-05,2026-12-16
NO_TRADE_DATES=
# Optional: PIP_OVERRIDES={"XAUUSD":0.1}

# --- local run ---
# Start with:  uvicorn app.main:app --port 8000 --env-file .env
# UI_PUBLIC=true lets you open http://127.0.0.1:8000/ui without the key. LOCAL USE ONLY.
UI_PUBLIC=true
# Optional storage locations (defaults: snr.db and setups/ inside the backend folder)
# DB_PATH=
# SETUPS_DIR=

# Charts (one timeframe alone per image; attached to Telegram/email and saved with each alert)
CHARTS_IN_ALERTS=true
CHART_THEME=light        # light | dark
CHART_STYLE=line         # line = closes (as in the course) | candles
